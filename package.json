{
  "name": "mascot-survey",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:html": "vitest run --coverage --reporter html",
    "test:coverage:lcov": "vitest run --coverage --reporter lcov",
    "test:coverage:json": "vitest run --coverage --reporter json",
    "format": "pnpm format:prettier && pnpm format:standard",
    "format:prettier": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,md}'",
    "format:standard": "standard --fix",
    "lint": "standard --check"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fingerprintjs/fingerprintjs": "^5.0.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-google-recaptcha": "^3.1.0",
    "vite-plugin-env-compatible": "^2.0.1"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "autoprefixer": "^10.4.23",
    "jsdom": "^27.3.0",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prettier-config-standard": "^7.0.0",
    "standard": "^17.1.2",
    "tailwindcss": "~4.1.18",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "prettier": "prettier-config-standard"
}
